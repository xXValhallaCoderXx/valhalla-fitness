# Supabase connection for the native spike. Copy to .env and restart with `expo start -c`
# (EXPO_PUBLIC_* vars are inlined at bundle time, so a plain reload is not enough).

# Local Supabase stack URL:
#   - expo web / Android emulator on the same machine: http://127.0.0.1:54321
#     (Android emulator alternative if 127.0.0.1 fails: http://10.0.2.2:54321)
#   - physical Android device on your LAN: http://<LAN-IP>:54321
#     (find your LAN IP with `ip addr` / `ifconfig`; device and machine must share the network)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The anon (publishable) key — printed by `supabase status` in the project that runs the stack.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OTP emails from the local stack are NOT actually sent — they arrive in the
# Mailpit inbox at http://127.0.0.1:54324 (open it in a browser to read the 6-digit code).

# Auth policy mirror (web AUTH_* equivalents). The open beta runs allowlist-off;
# unset values fail closed in production builds (signInWithOtp refuses new users).
EXPO_PUBLIC_AUTH_ALLOWLIST_ENABLED=false
EXPO_PUBLIC_AUTH_PASSWORD_ENABLED=false
