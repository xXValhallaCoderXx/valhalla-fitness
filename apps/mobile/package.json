{
  "name": "@sheetless/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sheetless/api": "workspace:*",
    "@sheetless/core": "workspace:*",
    "@sheetless/tokens": "workspace:*",
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/react-query": "5.101.0",
    "aes-js": "3.1.2",
    "expo": "~57.0.6",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.6",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.10.0",
    "react-native-url-polyfill": "3.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.0",
    "@testing-library/react-native": "13.3.3",
    "@types/aes-js": "3.1.4",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-router|@sheetless/.*|@tanstack/.*|@supabase/.*|react-navigation|@react-navigation/.*|react-native-svg))"
    ]
  }
}
