{
  "name": "@sheetless/web",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ./node_modules/vite/bin/vite.js dev",
    "build": "node --env-file-if-exists=../../.env ./node_modules/vite/bin/vite.js build && tsc --noEmit",
    "preview": "node --env-file-if-exists=../../.env ./node_modules/vite/bin/vite.js preview",
    "start": "node --env-file-if-exists=../../.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "pwa:verify": "node scripts/verify-pwa.mjs",
    "test": "vitest run",
    "test:api:integration": "vitest run --config vitest.api-integration.config.ts",
    "test:watch": "vitest",
    "export:templates": "vitest run --config scripts/export-templates.config.ts",
    "playwright": "playwright test",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:auth": "playwright test --project=setup",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/charts": "9.3.2",
    "@mantine/core": "^9.3.2",
    "@mantine/hooks": "^9.3.2",
    "@mantine/notifications": "9.3.2",
    "@sheetless/api": "workspace:*",
    "@sheetless/core": "workspace:*",
    "@sheetless/tokens": "workspace:*",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.26",
    "clsx": "2.1.1",
    "dayjs": "^1.11.21",
    "dexie": "4.4.4",
    "driver.js": "^1.6.0",
    "lucide-react": "1.21.0",
    "nitro": "3.0.260610-beta",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.9.2",
    "tailwind-merge": "3.6.0",
    "workbox-window": "^7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "22.19.21",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "27.2.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.0.15"
  }
}
