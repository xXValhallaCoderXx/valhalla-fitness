{
  "name": "sheetless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "dev": "pnpm --filter sheetless-web dev",
    "build": "pnpm --filter sheetless-web build",
    "preview": "pnpm --filter sheetless-web preview",
    "start": "pnpm --filter sheetless-web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter sheetless-web test:watch",
    "e2e": "pnpm --filter sheetless-web e2e",
    "e2e:headed": "pnpm --filter sheetless-web e2e:headed",
    "e2e:ui": "pnpm --filter sheetless-web e2e:ui",
    "e2e:auth": "pnpm --filter sheetless-web e2e:auth",
    "playwright": "pnpm --filter sheetless-web playwright",
    "shot": "pnpm --filter sheetless-web shot",
    "native": "pnpm --filter sheetless-native start",
    "native:android": "pnpm --filter sheetless-native android",
    "native:web": "pnpm --filter sheetless-native web",
    "export:templates": "pnpm --filter sheetless-web export:templates",
    "demo:seed": "pnpm --filter sheetless-web demo:seed",
    "demo:reset": "pnpm --filter sheetless-web demo:reset",
    "demo:refresh": "pnpm --filter sheetless-web demo:refresh",
    "demo:verify": "pnpm --filter sheetless-web demo:verify",
    "demo:list": "pnpm --filter sheetless-web demo:list",
    "provision:allowed": "pnpm --filter sheetless-web provision:allowed",
    "feedback:report": "pnpm --filter sheetless-web feedback:report",
    "pwa:verify": "pnpm --filter sheetless-web pwa:verify",
    "bundle:check": "pnpm --filter sheetless-web bundle:check",
    "architecture:check": "pnpm --filter sheetless-web architecture:check",
    "verify:native": "pnpm --filter sheetless-native exec expo export --platform web --platform android --output-dir .expo/verify-export",
    "docs:check": "node apps/web/scripts/check-docs.mjs",
    "db:contract:check": "node apps/web/scripts/check-database-contract.mjs",
    "db:audit": "node apps/web/scripts/audit-release-integrity.mjs",
    "db:migrate:local": "supabase db push --local --yes",
    "db:migrate": "supabase db push --db-url \"$SUPABASE_DB_URL\" --yes",
    "db:migrate:dry-run": "supabase db push --db-url \"$SUPABASE_DB_URL\" --dry-run",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/domain/src/shared/types/database.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm verify:native && pnpm pwa:verify && pnpm bundle:check && pnpm architecture:check && pnpm docs:check && pnpm db:contract:check"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "supabase": "^2.107.0"
  }
}
