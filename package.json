{
  "name": "sheetless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sheetless/web dev",
    "dev:web": "pnpm --filter @sheetless/web dev",
    "dev:mobile": "pnpm --filter @sheetless/mobile start",
    "build": "pnpm --filter @sheetless/web build",
    "preview": "pnpm --filter @sheetless/web preview",
    "start": "pnpm --filter @sheetless/web start",
    "db:migrate:local": "supabase db push --local --yes",
    "db:migrate": "supabase db push --db-url \"$SUPABASE_DB_URL\" --yes",
    "db:migrate:dry-run": "supabase db push --db-url \"$SUPABASE_DB_URL\" --dry-run",
    "db:types": "supabase gen types typescript --local --schema public > apps/web/src/shared/types/database.ts",
    "demo:seed": "node scripts/demo-data.mjs seed",
    "demo:reset": "node scripts/demo-data.mjs reset",
    "demo:refresh": "node scripts/demo-data.mjs refresh",
    "demo:verify": "node scripts/demo-data.mjs verify",
    "demo:list": "node scripts/demo-data.mjs list",
    "provision:allowed": "node scripts/provision-allowed-users.mjs",
    "feedback:report": "node scripts/feedback-report.mjs",
    "typecheck": "pnpm --filter @sheetless/web typecheck",
    "typecheck:web": "pnpm --filter @sheetless/web typecheck",
    "typecheck:shared": "pnpm --filter @sheetless/core --filter @sheetless/api --filter @sheetless/tokens typecheck",
    "typecheck:mobile": "pnpm --filter @sheetless/mobile typecheck",
    "pwa:verify": "pnpm --filter @sheetless/web pwa:verify",
    "test": "pnpm --filter @sheetless/web test",
    "test:web": "pnpm --filter @sheetless/web test",
    "test:shared": "pnpm --filter @sheetless/core --filter @sheetless/api --filter @sheetless/tokens test",
    "test:mobile": "pnpm --filter @sheetless/mobile test",
    "test:api:integration": "pnpm --filter @sheetless/web test:api:integration",
    "test:all": "pnpm test && pnpm test:shared && pnpm test:mobile",
    "test:watch": "pnpm --filter @sheetless/web test:watch",
    "export:templates": "pnpm --filter @sheetless/web export:templates",
    "lint": "eslint .",
    "playwright": "pnpm --filter @sheetless/web playwright",
    "e2e": "pnpm --filter @sheetless/web e2e",
    "e2e:headed": "pnpm --filter @sheetless/web e2e:headed",
    "e2e:ui": "pnpm --filter @sheetless/web e2e:ui",
    "e2e:auth": "pnpm --filter @sheetless/web e2e:auth",
    "shot": "pnpm --filter @sheetless/web shot",
    "expo:doctor": "pnpm --filter @sheetless/mobile exec expo-doctor"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "supabase": "^2.107.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1"
  }
}
